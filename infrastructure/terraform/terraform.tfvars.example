aws_region       = "us-east-1"
ami_id           = ""
instance_type    = "t3.micro"
key_name         = "logistics-ec2-key"
project_name     = "logistics-control-tower"
allowed_ssh_cidr = "104.28.241.158/32"
allowed_http_cidr = "0.0.0.0/0"
# This direct public-EC2 deployment needs internet egress for bootstrap,
# Docker image pulls, and GitHub deployments. The security group limits it
# to HTTP, HTTPS, and DNS ports.
allowed_egress_cidrs = ["0.0.0.0/0"]
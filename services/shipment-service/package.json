{
  "name": "shipment-service",
  "version": "1.0.0",
  "description": "Shipment Service for Logistics Control Tower",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
